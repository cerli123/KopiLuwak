# =============================================================================
#  CONTOH .env UNTUK cPANEL (salin jadi ".env" di server, lalu isi bagian ISI_...)
#  Jangan pernah meng-upload file .env ke GitHub.
# =============================================================================
APP_NAME="Kopiluwak Lereng Muria"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ISI_DOMAIN_ANDA.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Database dari cPanel > MySQL Database Wizard (nama DB & user berawalan nama akun cPanel)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ISI_NAMA_DATABASE
DB_USERNAME=ISI_USER_DATABASE
DB_PASSWORD=ISI_PASSWORD_DATABASE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Email (Gmail: pakai "App Password" 16 karakter). Sementara boleh MAIL_MAILER=log
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="emailanda@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Midtrans SANDBOX (uji coba). Key diawali SB-. Ganti ke key Production + IS_PRODUCTION=true saat resmi.
MIDTRANS_SERVER_KEY=SB-Mid-server-ISI
MIDTRANS_CLIENT_KEY=SB-Mid-client-ISI
MIDTRANS_IS_PRODUCTION=false

# Login Google (opsional, boleh dikosongkan dulu)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

REFUND_BATAS_HARI=7
ULASAN_STATUS_BOLEH=selesai
ULASAN_LANGSUNG_TAMPIL=true

TOKO_NAMA_LOKASI="Kopiluwak Lereng Muria"
TOKO_LAT=-6.6300
TOKO_LNG=110.8750
ONGKIR_TARIF_DASAR=10000
ONGKIR_KM_DASAR=3
ONGKIR_TARIF_PER_KM=2500
ONGKIR_MAKS_KM=150
ONGKIR_PEMBULATAN=500
ONGKIR_FAKTOR_JALAN=1.3
