# =============================================================================
#  KOPILUWAK LERENG MURIA - contoh .env (salin menjadi .env lalu: php artisan key:generate)
#  Nilai di bawah adalah setelan LOKAL (Laragon/XAMPP). Bila dipasang di hosting,
#  ubah minimal: APP_ENV, APP_DEBUG, APP_URL, DB_*  (contoh: env-production.contoh.txt)
#  Setelah mengubah .env jalankan:  php artisan config:clear
# =============================================================================

# ---------- Aplikasi ----------
APP_NAME="Kopiluwak Lereng Muria"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ---------- Log ----------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------- Database (MySQL) ----------
# Pada hosting Linux nama database bersifat HURUF BESAR/KECIL (case-sensitive).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=KopiLuwaksatu
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ---------- Session, cache, antrian, file ----------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database
QUEUE_CONNECTION=database

# ---------- Email ----------
# MAIL_MAILER=log  -> email hanya ditulis ke storage/logs (tidak terkirim).
# Untuk mengirim email sungguhan ganti MAIL_MAILER=smtp lalu isi MAIL_USERNAME & MAIL_PASSWORD
# (Gmail: pakai "App Password", bukan password akun).
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@kopiluwak.id"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- Midtrans (pembayaran) ----------
# Key diambil di dashboard.sandbox.midtrans.com > Settings > Access Keys
# MIDTRANS_SIMULATION=true  -> pembayaran SIMULASI (tanpa Midtrans, tanpa uang)
# MIDTRANS_SIMULATION=false -> pakai Midtrans (WAJIB isi kedua key di bawah)
# Butuh ekstensi PHP cURL aktif (php.ini: extension=curl).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SIMULATION=true

# ---------- Refund ----------
# Batas hari pelanggan boleh mengajukan refund
REFUND_BATAS_HARI=7

# ---------- Lokasi toko (titik asal ongkir) ----------
TOKO_NAMA_LOKASI="Kopiluwak Lereng Muria"
TOKO_LAT=-6.6300
TOKO_LNG=110.8750

# ---------- Ongkos kirim ----------
# Biaya = TARIF_DASAR (sampai KM_DASAR) + sisa km x TARIF_PER_KM, dibulatkan ke atas ke PEMBULATAN.
ONGKIR_TARIF_DASAR=10000
ONGKIR_KM_DASAR=3
ONGKIR_TARIF_PER_KM=2500
ONGKIR_MAKS_KM=150
ONGKIR_PEMBULATAN=500
ONGKIR_FAKTOR_JALAN=1.3

# ---------- Login dengan Google (Gmail) ----------
# Dapatkan di https://console.cloud.google.com/apis/credentials  (OAuth client ID, tipe "Web application")
# "Authorized redirect URI" HARUS sama persis dengan GOOGLE_REDIRECT_URI di bawah.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ---------- Ulasan produk ----------
# Status pesanan yang boleh memberi ulasan (pisahkan dengan koma). Bawaan: selesai
ULASAN_STATUS_BOLEH=selesai
# false = ulasan baru harus disetujui admin dulu sebelum tampil
ULASAN_LANGSUNG_TAMPIL=true
